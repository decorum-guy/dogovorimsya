# Merge the matching routes into the existing HAProxy configuration.
# These documentation IPs must be replaced with the real origin addresses.
# Preserve all existing default backends and unrelated services.
global
    user haproxy
    group haproxy
    daemon
    maxconn 2000

defaults
    mode tcp
    timeout connect 10s
    timeout client 1h
    timeout server 1h

frontend shared_http
    bind :80
    mode http
    timeout http-request 15s
    use_backend journal_http if { hdr(host),lower,field(1,:) -m str dogovorimsya.online }
    default_backend existing_http

backend existing_http
    mode http
    server existing_origin 192.0.2.20:80 check inter 10s fall 3 rise 2

frontend shared_https
    bind :443
    tcp-request inspect-delay 5s
    tcp-request content accept if { req.ssl_hello_type 1 }
    use_backend journal_https if { req.ssl_sni -i dogovorimsya.online }
    default_backend existing_https

backend existing_https
    server existing_origin 192.0.2.20:443 check inter 10s fall 3 rise 2

backend journal_http
    mode http
    server journal_origin 192.0.2.10:80 check inter 10s fall 3 rise 2

backend journal_https
    server journal_origin 192.0.2.10:443 check inter 10s fall 3 rise 2
